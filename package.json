{
    "name": "finances-control-backend",
    "version": "0.0.0",
    "private": true,
    "description": "API backend do Finances Control",
    "license": "ISC",
    "main": "dist/src/server.js",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/src/server.js",
        "start:local": "export NODE_ENV='local' && ts-node-dev --files --inspect=9229 --respawn src/server.ts",
        "check": "node scripts/check.mjs",
        "check:specs": "node scripts/check-specs.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
        "lint:fix": "eslint 'src/**/*.ts' 'tests/**/*.ts' --fix",
        "boundaries": "depcruise src",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "test:watch": "jest --watch"
    },
    "dependencies": {
        "@bhs-dev/typescript-common-env": "^1.0.0",
        "@bhs-dev/typescript-common-errors": "^1.0.0",
        "@bhs-dev/typescript-common-types": "^1.0.0",
        "express": "^5.1.0",
        "js-yaml": "^4.1.0",
        "reflect-metadata": "^0.2.2",
        "swagger-ui-express": "^5.0.1",
        "tslib": "^2.3.0",
        "tsyringe": "^4.10.0",
        "winston": "^3.17.0",
        "zod": "^4.1.9"
    },
    "devDependencies": {
        "@eslint/js": "^9.32.0",
        "@types/express": "^5.0.3",
        "@types/jest": "^30.0.0",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^22.10.0",
        "@types/supertest": "^6.0.2",
        "@types/swagger-ui-express": "^4.1.8",
        "dependency-cruiser": "^16.10.0",
        "dotenv": "^17.2.3",
        "eslint": "^9.32.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.3",
        "globals": "^16.3.0",
        "jest": "^30.0.5",
        "jest-environment-node": "^30.0.2",
        "jiti": "^2.5.1",
        "prettier": "^3.6.2",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.1",
        "ts-node": "^10.9.1",
        "ts-node-dev": "^2.0.0",
        "typescript": "~5.8.2",
        "typescript-eslint": "^8.39.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bhenriq-souza/finances-control-backend.git"
    }
}
