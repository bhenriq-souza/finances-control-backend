# Copie para .env.local e ajuste. Carregado apenas quando NODE_ENV=local.
# As obrigatórias estão declaradas em src/platform/config/env.list.ts —
# a aplicação falha no boot listando todas as que faltarem.

APPLICATION_NAME=finances-control-backend
APPLICATION_VERSION=0.0.0
ENV=local
SERVER_PORT=3000
DATABASE_URL=postgres://finances_app:<senha>@localhost:5432/finances_dev

# Opcionais (têm default)
# NODE_ENV=development
# LOG_LEVEL=info
# DATABASE_SSL=false
# DATABASE_POOL_MAX=10
